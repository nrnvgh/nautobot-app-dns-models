{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nautobot.example/schemas/reconcile_dns_job_result.schema.json",
  "title": "Reconcile DNS Job Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mode",
    "scope",
    "execution",
    "reconciliation"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "mode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dryrun",
        "single_object",
        "include_child_devices",
        "include_interfaces",
        "fast_mode",
        "execution_mode"
      ],
      "properties": {
        "dryrun": { "type": "boolean" },
        "single_object": { "type": "boolean" },
        "include_child_devices": { "type": "boolean" },
        "include_interfaces": { "type": "boolean" },
        "fast_mode": { "type": "boolean" },
        "execution_mode": {
          "type": "string",
          "enum": ["standard", "fast"]
        },
        "pipeline_stage_metrics": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "batches",
            "objects_total",
            "tracking_rows_total",
            "pending_rule_calculations_total",
            "pending_bulk_updates_total",
            "fallback_chunk_attempt_count_total",
            "fallback_singleton_attempt_count_total",
            "fallback_singleton_failure_count_total",
            "update_failure_recorded_count_total",
            "stage_metrics",
            "avg_per_batch"
          ],
          "properties": {
            "batches": { "type": "integer", "minimum": 0 },
            "objects_total": { "type": "number", "minimum": 0 },
            "tracking_rows_total": { "type": "number", "minimum": 0 },
            "pending_rule_calculations_total": { "type": "number", "minimum": 0 },
            "pending_bulk_updates_total": { "type": "number", "minimum": 0 },
            "fallback_chunk_attempt_count_total": { "type": "number", "minimum": 0 },
            "fallback_singleton_attempt_count_total": { "type": "number", "minimum": 0 },
            "fallback_singleton_failure_count_total": { "type": "number", "minimum": 0 },
            "update_failure_recorded_count_total": { "type": "number", "minimum": 0 },
            "stage_metrics": {
              "type": "object",
              "additionalProperties": false,
              "required": ["fetch", "planning", "apply", "bulk_flush", "total"],
              "properties": {
                "fetch": { "type": "number", "minimum": 0 },
                "planning": { "type": "number", "minimum": 0 },
                "apply": { "type": "number", "minimum": 0 },
                "bulk_flush": { "type": "number", "minimum": 0 },
                "total": { "type": "number", "minimum": 0 }
              }
            },
            "avg_per_batch": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "objects",
                "tracking_rows",
                "pending_rule_calculations",
                "pending_bulk_updates",
                "fallback_chunk_attempt_count",
                "fallback_singleton_attempt_count",
                "fallback_singleton_failure_count",
                "update_failure_recorded_count",
                "stage_metrics"
              ],
              "properties": {
                "objects": { "type": "number", "minimum": 0 },
                "tracking_rows": { "type": "number", "minimum": 0 },
                "pending_rule_calculations": { "type": "number", "minimum": 0 },
                "pending_bulk_updates": { "type": "number", "minimum": 0 },
                "fallback_chunk_attempt_count": { "type": "number", "minimum": 0 },
                "fallback_singleton_attempt_count": { "type": "number", "minimum": 0 },
                "fallback_singleton_failure_count": { "type": "number", "minimum": 0 },
                "update_failure_recorded_count": { "type": "number", "minimum": 0 },
                "stage_metrics": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["fetch", "planning", "apply", "bulk_flush", "total"],
                  "properties": {
                    "fetch": { "type": "number", "minimum": 0 },
                    "planning": { "type": "number", "minimum": 0 },
                    "apply": { "type": "number", "minimum": 0 },
                    "bulk_flush": { "type": "number", "minimum": 0 },
                    "total": { "type": "number", "minimum": 0 }
                  }
                }
              }
            }
          }
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scanned_models",
        "filters"
      ],
      "properties": {
        "scanned_models": {
          "type": "array",
          "items": { "type": "string" }
        },
        "filters": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_models",
            "rule_ids",
            "location_ids",
            "tenant_ids",
            "limit",
            "batch_size"
          ],
          "properties": {
            "source_models": { "type": "array", "items": { "type": "string" } },
            "rule_ids": { "type": "array", "items": { "type": "string" } },
            "location_ids": { "type": "array", "items": { "type": "string" } },
            "tenant_ids": { "type": "array", "items": { "type": "string" } },
            "limit": { "type": ["integer", "null"], "minimum": 1 },
            "batch_size": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targets_selected_count",
        "targets_processed_count",
        "targets_succeeded_count",
        "targets_failed_count",
        "runtime_seconds"
      ],
      "properties": {
        "targets_selected_count": { "type": "integer", "minimum": 0 },
        "targets_processed_count": { "type": "integer", "minimum": 0 },
        "targets_succeeded_count": { "type": "integer", "minimum": 0 },
        "targets_failed_count": { "type": "integer", "minimum": 0 },
        "runtime_seconds": { "type": "number", "minimum": 0 }
      }
    },
    "reconciliation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objects_with_existing_rule_records",
        "existing_rule_record_count",
        "objects_changed",
        "dns_record_create_count",
        "dns_record_delete_count",
        "dns_record_update_count",
        "dns_record_unchanged_count",
        "dns_record_total_count",
        "changed_record_count",
        "targets_noop_count",
        "fallback_chunk_attempt_count",
        "fallback_singleton_attempt_count",
        "fallback_singleton_failure_count",
        "update_failure_recorded_count"
      ],
      "properties": {
        "objects_with_existing_rule_records": { "type": "integer", "minimum": 0 },
        "existing_rule_record_count": { "type": "integer", "minimum": 0 },
        "objects_changed": { "type": "integer", "minimum": 0 },
        "dns_record_create_count": { "type": "integer", "minimum": 0 },
        "dns_record_delete_count": { "type": "integer", "minimum": 0 },
        "dns_record_update_count": { "type": "integer", "minimum": 0 },
        "dns_record_unchanged_count": { "type": "integer", "minimum": 0 },
        "dns_record_total_count": { "type": "integer", "minimum": 0 },
        "changed_record_count": { "type": "integer", "minimum": 0 },
        "targets_noop_count": { "type": "integer", "minimum": 0 },
        "fallback_chunk_attempt_count": { "type": "integer", "minimum": 0 },
        "fallback_singleton_attempt_count": { "type": "integer", "minimum": 0 },
        "fallback_singleton_failure_count": { "type": "integer", "minimum": 0 },
        "update_failure_recorded_count": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
